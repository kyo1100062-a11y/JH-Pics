# Supabase 프로젝트 설정 예시
# 실제 config.toml은 supabase init 또는 supabase link 후 자동 생성됩니다

[project]
# Supabase 프로젝트 참조 ID
# Supabase Dashboard → Settings → General에서 확인
project_id = "your-project-ref"

[api]
# API 엔드포인트
enabled = true
port = 54321
schemas = ["public", "storage", "graphql_public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

[db]
# 데이터베이스 설정
port = 54322
major_version = 15

[studio]
# Supabase Studio 설정
enabled = true
port = 54323

[inbucket]
# 이메일 테스트 서버
enabled = true
port = 54324

[storage]
# Storage 설정
enabled = true
file_size_limit = "50MiB"

[edge_runtime]
# Edge Functions 설정
enabled = true
port = 54325

[functions]
# Edge Functions 목록
projects = { verify_jwt = false }
picture_sets = { verify_jwt = false }
upload = { verify_jwt = false }

